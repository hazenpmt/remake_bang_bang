[sub_resource type="Shader" id="Shader_map_rounded"]
code = "shader_type canvas_item;

uniform float corner_radius_px = 8.0;
uniform vec2 rect_size_px = vec2(168.0, 100.0);

void fragment() {
	vec4 texel = texture(TEXTURE, UV);
	vec2 point = abs(UV - vec2(0.5)) * rect_size_px;
	vec2 inner = rect_size_px * 0.5 - vec2(corner_radius_px);
	vec2 outside = max(point - inner, vec2(0.0));
	float distance_to_edge = length(outside) - corner_radius_px;
	texel.a *= 1.0 - smoothstep(-0.75, 0.75, distance_to_edge);
	COLOR = texel;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_map_rounded"]
shader = SubResource("Shader_map_rounded")
shader_parameter/corner_radius_px = 8.0
shader_parameter/rect_size_px = Vector2(168, 100)

