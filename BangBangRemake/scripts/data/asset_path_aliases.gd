static func resolve(asset_path: String) -> String:
	var resolved := asset_path.strip_edges()
	if resolved.is_empty():
		return resolved
	var visited: Dictionary = {}
	while ALIASES.has(resolved) and not visited.has(resolved):
		visited[resolved] = true
		resolved = String(ALIASES[resolved])
	return resolved

static func resource_exists(asset_path: String, type_hint: String = "") -> bool:
	var resolved := resolve(asset_path)
	return not resolved.is_empty() and ResourceLoader.exists(resolved, type_hint)

static func load_resource(
	asset_path: String,
	type_hint: String = "",
	cache_mode: int = ResourceLoader.CACHE_MODE_REUSE
) -> Resource:
	var resolved := resolve(asset_path)
	if resolved.is_empty() or not ResourceLoader.exists(resolved, type_hint):
		return null
	return ResourceLoader.load(resolved, type_hint, cache_mode)

static func load_texture(asset_path: String) -> Texture2D:
	return load_resource(asset_path, "Texture2D") as Texture2D
