PORT=8080
DATABASE_URL=postgresql://bangbang:change_me@127.0.0.1:5432/bangbang
SESSION_DAYS=30
ALLOWED_ORIGIN=*
MAX_ONLINE_PLAYERS=100
PRESENCE_LEASE_SECONDS=30
HEARTBEAT_INTERVAL_SECONDS=10
QUEUE_TICKET_SECONDS=30
QUEUE_POLL_SECONDS=3
WORLD_CHAT_RESET_ON_SERVER_START=true
LOGIN_RATE_LIMIT=8
LOGIN_RATE_WINDOW_SECONDS=60
QUEUE_POLL_RATE_LIMIT=30
REGISTRATION_COOLDOWN_SECONDS=10800
REGISTRATION_HASH_SECRET=replace_with_a_random_secret
TRUST_PROXY=false
WEB_PROXY_SECRET=
NODE_ENV=development
CONTENT_STORAGE_ROOT=./content_storage
CONTENT_PUBLIC_BASE_URL=
CONTENT_MAX_IMAGE_BYTES=16777216
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_KEY_SECRET=replace_with_a_different_random_secret
REDIS_URL=
RATE_LIMIT_REDIS_CONNECT_TIMEOUT_MS=5000
RATE_LIMIT_PREFIX=bangbang:rate-limit
SECURITY_TELEMETRY_FLUSH_MS=1000
SECURITY_TELEMETRY_BATCH_SIZE=100
SECURITY_TELEMETRY_QUEUE_LIMIT=5000
METRICS_ENABLED=false
METRICS_BEARER_TOKEN=
BATTLE_TICK_MS=50
BATTLE_TICK_BATCH_SIZE=100
BATTLE_TICK_CONCURRENCY=8
BATTLE_REALTIME_SNAPSHOT_MS=100
BATTLE_REALTIME_FULL_SNAPSHOT_MS=5000
BATTLE_REALTIME_DELTA_MAX_RATIO_BASIS_POINTS=8500
BATTLE_REALTIME_HEARTBEAT_MS=10000
BATTLE_REALTIME_MESSAGE_LIMIT=80
BATTLE_REALTIME_MESSAGE_WINDOW_MS=1000
BATTLE_REALTIME_MAX_BUFFERED_BYTES=262144
BATTLE_REALTIME_REQUIRE_TICKET=true
BATTLE_REALTIME_TICKET_SECONDS=30
BATTLE_PUBLIC_REALTIME_URL=
BATTLE_NODE_ID=local
BATTLE_WORKER_NODE_LEASE_MS=15000
BATTLE_RUNTIME_ENABLED=true
BATTLE_MEMORY_WORKERS=true
BATTLE_CHECKPOINT_MS=500
BATTLE_WORKER_LEASE_MS=5000
BATTLE_WORKER_DISCOVERY_MS=1000
BATTLE_WORKER_LIMIT=100
